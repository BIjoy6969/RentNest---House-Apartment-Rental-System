{
  "buildCommand": "cd rentnest-frontend && CI=false npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "rentnest-frontend/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
